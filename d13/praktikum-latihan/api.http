@baseUrl = http://localhost:8080

### Health
GET {{baseUrl}}/health HTTP/1.1

### CREATE Transaksi Pemesanan (Checkout)
POST {{baseUrl}}/api/v1/orders HTTP/1.1
Content-Type: : application/json

{
    "user_id": 1,
    "items": [
        {"product_id": 1, "quantity": 42},
        {"product_id": 2, "quantity": 34}
    ]
}

### READ Orders by id
GET {{baseUrl}}/api/v1/orders/4 HTTP/1.1

### PUT Orders Cancel Checkout
PUT {{baseUrl}}/api/v1/orders/4/cancel HTTP/1.1
Content-Type: application/json

### READ Analutics Popular Product
GET {{baseUrl}}/api/v1/analytics/popular-products HTTP/1.1

#######################

### Register
POST {{baseUrl}}/api/v1/auth/register HTTP/1.1
Content-Type: application/json

{
    "email": "rucco@gmail.com",
    "password": "rucco123456789",
    "role": "ADMIN"
}

### Login
# @name login
POST {{baseUrl}}/api/v1/auth/login HTTP/1.1
Content-Type: : application/json

{
    "email": "rucco@gmail.com",
    "password": "rucco123456789"
}

@token = {{login.response.body.token}}

### Me ADMIN
GET {{baseUrl}}/api/v1/auth/me-admin HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

### Me USER
GET {{baseUrl}}/api/v1/auth/me-user HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

### Logout
POST {{baseUrl}}/api/v1/auth/logout HTTP/1.1
Content-Type: : application/json
Authorization: Bearer {{token}}